# SPDX-License-Identifier: GPL-3.0-or-later
# Defaults for the TherIQ boiler unit. The generated `sdkconfig` is not committed;
# change settings here so every build (local, devcontainer, CI) is the same.

# Target and flash
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Bluetooth LE is used only for Matter commissioning (pairing)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Matter runs over Wi-Fi with IPv6; no soft-AP
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_HKDF_C=y

# No automatic Matter OTA queries: updates only when the user starts them (R1, R2)
CONFIG_ENABLE_OTA_REQUESTOR=n

# Console (logs and input) on the built-in USB-Serial/JTAG: both boards only
# have a USB-C port. Default UART0 would leave USB output-only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Matter shell on the serial console (e.g. `matter onboardingcodes ble`)
CONFIG_ENABLE_CHIP_SHELL=y
